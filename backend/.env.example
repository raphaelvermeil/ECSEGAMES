PORT=8082
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=ecsegames
CLERK_SECRET_KEY=sk_test_xxx
FRONTEND_ORIGIN=http://localhost:3000
CSCOMP_SOLUTIONS_DIR=./images/cs-comp/solutions
CHROME_PATH=
# Set to 1 in containers (the Dockerfile does); see config.go.
CHROME_NO_SANDBOX=
CSCOMP_RENDER_CONCURRENCY=4
CSCOMP_MINUTES=45

# Throwaway database for `go test ./...`. The users integration tests insert and
# delete documents, so they run only when this is set and never use MONGO_URI.
TEST_MONGO_URI=
TEST_MONGO_DB=ecsegames_test

# Cloudflare R2 bucket holding Scunts photo/video submissions. Without all
# four, /api/scunts/* reports 503 and the rest of the app is unaffected.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
