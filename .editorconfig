root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go uses tabs by convention (gofmt)
[*.go]
indent_style = tab

[Makefile]
indent_style = tab

# Don't trim trailing whitespace in Markdown (hard line breaks)
[*.md]
trim_trailing_whitespace = false
